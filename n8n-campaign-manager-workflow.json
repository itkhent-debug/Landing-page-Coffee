                  {
                      "parameters":  {
                                         "jsCode":  "const body = $input.first().json.body || $input.first().json;\nconst recipients = Array.isArray(body.recipients) ? [...new Set(body.recipients)] : [];\nconst subject = body.subject || \"Update from Cafe Brewm\";\nconst message = body.message || \"\";\nlet binaryData;\nif (body.imageBase64) {\n  const base64 = String(body.imageBase64).split(\",\").pop();\n  const buffer = Buffer.from(base64, \"base64\");\n  binaryData = await this.helpers.prepareBinaryData(buffer, \"campaign-image.jpg\", body.imageMimeType || \"image/jpeg\");\n}\nreturn recipients.map(email =\u003e {\n  const item = { json: { email: email, subject: subject, message: message } };\n  if (binaryData) item.binary = { attachment: binaryData };\n  return item;\n});",
